{
  "name": "monet-design-system",
  "private": true,
  "version": "0.1.0",
  "description": "A local design-system workspace that gives coding agents task-specific guidance and checks reported evidence through read-only MCP.",
  "license": "MIT",
  "homepage": "https://github.com/arieskg/monet#readme",
  "repository": { "type": "git", "url": "git+https://github.com/arieskg/monet.git" },
  "bugs": { "url": "https://github.com/arieskg/monet/issues" },
  "keywords": [
    "design-system",
    "design-tokens",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "coding-agents",
    "design-to-code",
    "workspace"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "concurrently -k -n app,files -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:app": "vite",
    "dev:server": "tsx watch server/index.ts",
    "mcp": "tsx mcp/index.ts",
    "validate": "tsx server/validateCli.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:mcp": "vitest run mcp/server.test.ts",
    "check": "pnpm run build && pnpm run lint && pnpm run test && pnpm run validate",
    "test:surfaces:browser": "playwright test -c tests/surfaces/playwright.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "css-tree": "3.2.1",
    "parse5": "8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4",
    "vite": "7.3.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.63.0",
    "@types/css-tree": "3.2.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sanitize-html": "2.16.1",
    "concurrently": "9.2.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "30.0.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
